# ==============================================================================
# QualiSense AI — Backend Environment Configuration Example
# ==============================================================================

# Database Connection (SQLite by default, or PostgreSQL for production)
# SQLite example: sqlite:///./qualisense.db
# PostgreSQL example: postgresql://username:password@ep-db.cloud.neon.tech/qualisense
DATABASE_URL=sqlite:///./qualisense.db

# JWT Cryptographic Secret (Generate a strong random key in production!)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# JWT Expiration Periods
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (Comma-separated URLs for web frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenBLAS / Multithreading CPU constraints (Required for Windows stability)
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
